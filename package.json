{
  "name": "label-lens",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "eval:resolver": "tsx evals/run-resolver.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ingest:fetch": "NODE_USE_ENV_PROXY=1 tsx packages/ingest/src/fetch.ts",
    "golden:update": "tsx scripts/golden-update.ts",
    "eval:retrieval": "tsx evals/run-retrieval.ts",
    "eval:claims": "tsx evals/run-claims.ts",
    "eval": "npm run eval:resolver && npm run eval:retrieval && npm run eval:claims && npm run eval:pipeline && npm run eval:refusals",
    "eval:pipeline": "tsx evals/run-pipeline.ts",
    "check:openai": "NODE_USE_ENV_PROXY=1 tsx scripts/check-openai.ts",
    "eval:live": "NODE_USE_ENV_PROXY=1 tsx evals/run-live.ts",
    "eval:refusals": "tsx evals/run-refusals.ts",
    "eval:refusals:live": "NODE_USE_ENV_PROXY=1 tsx evals/run-refusals.ts --live"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
